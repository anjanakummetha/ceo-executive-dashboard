# CEO Dashboard — PRODUCTION env template. Copy to .env.production on the VPS
# (referenced by deploy/ceo-dashboard.service via EnvironmentFile).
# Fill the blank secrets; connection IDs below are the shared Composio account
# used by the Lexi agent (read-only).

NODE_ENV=production
USE_MOCK_DATA=false

# ─── Auth (REQUIRED in production) ─────────────────────────────────────────
REQUIRE_AUTH=true
NEXT_PUBLIC_REQUIRE_AUTH=true
AUTH_SECRET=            # >= 16 random chars
DASHBOARD_USERNAME=kory
DASHBOARD_PASSWORD=     # strong password

# ─── Composio (SAME account/connections as the Lexi agent; read-only) ──────
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=Kory
COMPOSIO_OUTLOOK_CONNECTED_ACCOUNT_ID=ca_qORrE-NzPib2
COMPOSIO_ASANA_CONNECTED_ACCOUNT_ID=ca_cISuS3L6HDZn
COMPOSIO_LINKEDIN_CONNECTED_ACCOUNT_ID=ca_c_o9UMJRZkMe
ASANA_PROJECT_NAME=Kory NON-IFG

# ─── AI (direct Anthropic; testing key for now, swap prod key at cutover) ──
ANTHROPIC_API_KEY=
HERMES_DISABLE_CLI=true
HERMES_INFERENCE_MODEL=claude-sonnet-5

# ─── Lexi agent read-only API (localhost; token must match the agent) ──────
LEXI_API_URL=http://127.0.0.1:8081
LEXI_API_TOKEN=        # same value as LEXI_API_TOKEN in /opt/lexi/.env.production

# ─── Persistence ───────────────────────────────────────────────────────────
DASHBOARD_DATA_DIR=/var/lib/ceo-dashboard

BRIEFING_EMAIL_TO=kory@iconicfounders.com

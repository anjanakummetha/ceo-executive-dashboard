# ─── Composio ───────────────────────────────────────────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Separate connected accounts per toolkit (from Composio dashboard)
COMPOSIO_ASANA_CONNECTED_ACCOUNT_ID=
COMPOSIO_OUTLOOK_CONNECTED_ACCOUNT_ID=
COMPOSIO_LINKEDIN_CONNECTED_ACCOUNT_ID=

NEXT_PUBLIC_ASANA_PROJECT_GID=

# Legacy fallback for Asana only
# COMPOSIO_CONNECTED_ACCOUNT_ID=

# ─── Asana (Kory NON-IFG only — not IFG Tasks) ────────────────────────────
ASANA_PROJECT_NAME=Kory NON-IFG
# ASANA_PROJECT_GID=

# ─── Auth (optional — single-user local use can leave off) ────────────────
# REQUIRE_AUTH=true
# NEXT_PUBLIC_REQUIRE_AUTH=true
# AUTH_SECRET=
# DASHBOARD_USERNAME=kory
# DASHBOARD_PASSWORD=

# ─── AI (direct Anthropic API; no local Hermes daemon needed) ─────────────
# In production, set HERMES_DISABLE_CLI=true so summaries call api.anthropic.com
# directly using ANTHROPIC_API_KEY (no Hermes process dependency).
ANTHROPIC_API_KEY=
HERMES_DISABLE_CLI=true
# Current model; override to a cheaper tier (e.g. a Haiku model) to cut cost.
HERMES_INFERENCE_MODEL=claude-sonnet-5
# HERMES_CLI_PATH=hermes          # only if HERMES_DISABLE_CLI is false
# HERMES_TIMEOUT_MS=180000
HERMES_BASE_URL=http://127.0.0.1:8080

# Daily briefing email draft (POST /api/hermes/briefing) — DRAFT ONLY.
# This dashboard never sends email; the Lexi agent owns Teams briefing delivery.
BRIEFING_EMAIL_TO=kory@iconicfounders.com

# ─── Lexi agent (read-only /api/v1 for the "Lexi Assistant" panel) ─────────
# Localhost only; must match LEXI_API_ENABLED=true + LEXI_API_TOKEN on the agent.
LEXI_API_URL=http://127.0.0.1:8081
LEXI_API_TOKEN=

# ─── Persistent data dir (health logs, briefing, AI cache) ─────────────────
# Standalone redeploys wipe ./data — point at a stable path in production.
# DASHBOARD_DATA_DIR=/var/lib/ceo-dashboard

# ─── Outlook travel & family (Travel tab) ────────────────────────────────
# OUTLOOK_TRAVEL_DAYS_PAST=7
# OUTLOOK_TRAVEL_DAYS_AHEAD=90

# ─── Outlook inbox (Inbox tab) ───────────────────────────────────────────
# OUTLOOK_INBOX_DAYS=14
# OUTLOOK_INBOX_TOP=75

# Attendee bios use cached inbox only (no per-person Outlook search). Keep TOP modest for API cost.
# ATTENDEE_EMAIL_SNIPPETS=4

# ─── App ──────────────────────────────────────────────────────────────────
USE_MOCK_DATA=false

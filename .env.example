# ─── Composio ───────────────────────────────────────────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Separate connected accounts per toolkit (from Composio dashboard)
COMPOSIO_ASANA_CONNECTED_ACCOUNT_ID=
COMPOSIO_OUTLOOK_CONNECTED_ACCOUNT_ID=
COMPOSIO_LINKEDIN_CONNECTED_ACCOUNT_ID=

NEXT_PUBLIC_ASANA_PROJECT_GID=

# Legacy fallback for Asana only
# COMPOSIO_CONNECTED_ACCOUNT_ID=

# ─── Asana (Kory NON-IFG only — not IFG Tasks) ────────────────────────────
ASANA_PROJECT_NAME=Kory NON-IFG
# ASANA_PROJECT_GID=

# ─── Auth (optional — single-user local use can leave off) ────────────────
# REQUIRE_AUTH=true
# NEXT_PUBLIC_REQUIRE_AUTH=true
# AUTH_SECRET=
# DASHBOARD_USERNAME=kory
# DASHBOARD_PASSWORD=

# ─── Hermes AI (CLI one-shot; Composio MCP in ~/.hermes/config.yaml) ───────
HERMES_CLI_PATH=hermes
# HERMES_TIMEOUT_MS=180000
# HERMES_DISABLE_CLI=true
# HERMES_INFERENCE_MODEL=claude-sonnet-4-20250514
HERMES_BASE_URL=http://127.0.0.1:8080

# Daily briefing email draft (POST /api/hermes/briefing — never auto-sends)
BRIEFING_EMAIL_TO=kory@iconicfounders.com
# BRIEFING_SEND_ENABLED=false

# ─── Outlook travel & family (Travel tab) ────────────────────────────────
# OUTLOOK_TRAVEL_DAYS_PAST=7
# OUTLOOK_TRAVEL_DAYS_AHEAD=90

# ─── Outlook inbox (Inbox tab) ───────────────────────────────────────────
# OUTLOOK_INBOX_DAYS=14
# OUTLOOK_INBOX_TOP=75

# Attendee bios use cached inbox only (no per-person Outlook search). Keep TOP modest for API cost.
# ATTENDEE_EMAIL_SNIPPETS=4

# ─── App ──────────────────────────────────────────────────────────────────
USE_MOCK_DATA=false
